# Local-only Phase 1 configuration. Do not put broker credentials in this file.
ALGO_MANUS_DATA_DIR=.local/algo_manus
ALGO_MANUS_INSTRUMENT_MAX_AGE_HOURS=24
ALGO_MANUS_DEFAULT_BROKER=angel_one
ALGO_MANUS_LIVE_TRADING=false

# Angel local configuration. Do not commit actual values or paste them into the
# workbench/chat. Option C reads these values from a user-managed local process
# environment only; it never renders, logs or persists them.
# ALGO_MANUS_ANGEL_APP_KEY=<your-local-app-key>
# ALGO_MANUS_ANGEL_MAC_ADDRESS=<your-local-device-mac-address>
# ALGO_MANUS_ANGEL_CLIENT_CODE=<your-local-client-code>
# ALGO_MANUS_ANGEL_PIN=<your-local-pin>
# ALGO_MANUS_ANGEL_TOTP=<current-authenticator-code>
# ALGO_MANUS_ANGEL_LOCAL_IP=<your-local-private-ip>
# ALGO_MANUS_ANGEL_PUBLIC_IP=<your-local-public-ip>
# Optional legacy/manual handoff only; Option C replaces this with an in-memory
# token after the user explicitly starts a local session.
# ALGO_MANUS_ANGEL_ACCESS_TOKEN=<existing-short-lived-access-token>
